<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="city_report_privilege" model="res.groups.privilege">
        <field name="name">City Report</field>
        <field name="category_id" ref="city_management.module_category_city_report" />
    </record>
    <record id="group_self_created" model="res.groups">
        <field name="name">Only self created</field>
        <field name="privilege_id" ref="city_management.city_report_privilege" />
    </record>
    <record id="group_responsible_id" model="res.groups">
        <field name="name">Only assigned reports</field>
        <field name="privilege_id" ref="city_management.city_report_privilege" />
        <field name="implied_ids" eval="[(4, ref('city_management.group_self_created'))]"/>
    </record>
    <record id="group_report_manager" model="res.groups">
        <field name="name">Report Manager</field>
        <field name="privilege_id" ref="city_management.city_report_privilege" />
        <field name="implied_ids" eval="[(4, ref('city_management.group_responsible_id'))]"/>
    </record>
</odoo>