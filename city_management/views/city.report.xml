<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="city_report_view_search" model="ir.ui.view">
        <field name="name">city.report.view.search</field>
        <field name="model">city.report</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name" />
                <field name="mobile" />
                <field name="category_id" />
                <field name="subcategory_id" />
                <filter name="date" string="Create date" date="create_date" />
                <separator />
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]" />
                <filter name="in_progress" string="En progreso" domain="[('state', '=', 'in_progress')]" />
                <filter name="done" string="Done" domain="[('state', '=', 'done')]" />
                <filter name="cancel" string="Cancelled" domain="[('state', '=', 'cancel')]" />
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]" />
                <filter name="open" string="Open" domain="[('state', 'not in', ['draft','done','cancel','rejected'])]" />
                <filter name="closed" string="Closed" domain="[('state', 'in', ['draft','done','cancel','rejected'])]" />
                <filter name="groupby_category" string="Category" context="{'group_by': 'category_id'}" />
                <filter name="groupby_subcategory" string="Subcategory" context="{'group_by': 'subcategory_id'}" />
                <filter name="groupby_state" string="State" context="{'group_by': 'state'}" />
            </search>
        </field>
    </record>
    <record id="city_report_view_tree" model="ir.ui.view">
        <field name="name">city.report.view.tree</field>
        <field name="model">city.report</field>
        <field name="arch" type="xml">
            <list string="Reportes">
                <field name="name" string="Solicitud"/>
                <field name="category_id" />
                <field name="subcategory_id" />
                <field name="create_date" />
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state in ['cancel','rejected']" decoration-info="state == 'in_progress'"/>
                <field name="progress" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="city_report_view_form" model="ir.ui.view">
        <field name="name">city.report.view.form</field>
        <field name="model">city.report</field>
        <field name="arch" type="xml">
            <form string="Reporte">
                <header>
                    <button string="Resolver Solicitud" name="mark_as_done" type="object" class="oe_highlight" invisible="state != 'in_progress'" />
                    <button string="Cancelar Solicitud" name="mark_as_cancel" type="object" class="bg-danger text-white" invisible="state != 'in_progress'" />
                    <button string="Solicitud Sin Resolver" name="mark_as_pending" type="object" class="bg-danger text-white" invisible="state != 'in_progress'" />
                    <button string="Pasar a pendiente" name="mark_as_pending" type="object" class="bg-danger text-white" invisible="state != 'draft'" />
                    <button string="Aceptar Solicitud" name="mark_as_in_progress" type="object" class="oe_highlight" invisible="state != 'pending'" />
                    <button string="Rechazar Solicitud" name="mark_as_rejected" type="object" class="bg-danger text-white" invisible="state != 'pending'" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Solicitud"/>
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group name="category">
                            <field name="category_id" />
                            <field name="subcategory_id" />
                        </group>
                        <group name="contact_info">
                            <field name="report_address" />
                            <field name="mobile" />
                            <field name="neighbour_id" context="{'form_view_ref': 'city_management.view_res_partner_neighbors_form'}"/>
                        </group>
                    </group>
                    <group name="details">
                        <group name="note">
                            <field name="create_date" string="Fecha de alta" />
                            <field name="cancel_reason" invisible="cancel_reason == False" />
                            <field name="note" />
                        </group>
                        <group name="write_date">
                            <field name="write_date" />
                            <field name="user_attachment_link" />
                            <field name="user_attachment_filename" invisible="1"/>
                            <field name="user_attachment" filename="user_attachment_filename" />
                        </group>
                    </group>
                    <notebook>
                        <page name="state_log" string="Historial de estados">
                            <field name="state_log_ids" readonly="1">
                                <list>
                                    <field name="create_date" />
                                    <field name="create_uid" />
                                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state in ['cancel','rejected']" decoration-info="state == 'in_progress'"/>
                                </list>
                            </field>
                        </page>
                        <page name="client_data" string="Información del vecino">
                            <group>

                                <group name="personal_info">
                                    <field name="gender" />
                                    <field name="age" />
                                    <field name="marital_status" />
                                    <field name="dependent_children" />
                                </group>
                                <group name="feedback_info">
                                    <field name="satisfaction_level" />
                                    <field name="expressed_feelings" />
                                    <field name="willingness_for_volunteering" />
                                    <field name="citizen_intention_id" />
                                    <field name="user_id" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>

            </form>
        </field>
    </record>

</odoo>
