<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sendpulse_auth_get_oauth_cron" model="ir.cron">
        <field name="name">Get senpulse token</field>
        <field name="model_id" ref="model_sendpulse_auth"/>
        <field name="interval_number">45</field>
        <field name="interval_type">minutes</field>
        <field name="state">code</field>
        <field name="code">
            for r in model.search([]):
                r.get_oauth()
        </field>
    </record>

    <!-- Cron Job for Template Synchronization -->
    <record id="sendpulse_sync_templates_cron" model="ir.cron">
        <field name="name">Sync SendPulse WhatsApp Templates</field>
        <field name="model_id" ref="model_sendpulse_template"/>
        <field name="state">code</field>
        <field name="code">model.sync_templates_with_sendpulse()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>

</odoo>
